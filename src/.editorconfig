[*]
max_line_length = 500

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2
xml_space_inside_empty_tag = true

[*.cs]

dotnet_analyzer_diagnostic.severity = default

#### Core EditorConfig Options ####

indent_style = space
indent_size = 4
insert_final_newline = false

#### Code quality analysis (production library code) ####

# CancellationToken must be the last parameter
dotnet_diagnostic.CA1068.severity = error
# Library code awaits with ConfigureAwait(false)
dotnet_diagnostic.CA2007.severity = error
# Forward the CancellationToken to methods that accept one
dotnet_diagnostic.CA2016.severity = error

#### .NET coding conventions ####

dotnet_style_qualification_for_event = false:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_namespace_match_folder = false
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
dotnet_style_require_accessibility_modifiers = omit_if_default:warning

#### Test projects ####

# Tests are not library code: they do not use ConfigureAwait, and helpers do not take cancellation tokens.
# This section comes last so that it overrides the library defaults above.
[{NServiceBus.Community.Mqtt.Tests,NServiceBus.Community.Mqtt.TransportTests,NServiceBus.Community.Mqtt.AcceptanceTests}/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.PS0018.severity = none
