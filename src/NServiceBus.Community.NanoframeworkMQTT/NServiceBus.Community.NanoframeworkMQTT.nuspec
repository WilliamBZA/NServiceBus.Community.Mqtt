<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata minClientVersion="2.8">
    <id>NServiceBus.Community.NanoframeworkMQTT</id>
    <version>1.0.0</version>
    <title>NServiceBus.Community.NanoframeworkMQTT</title>
    <authors>WilliamBZA</authors>
    <owners>WilliamBZA</owners>
    <license type="expression">MIT</license>
    <readme>docs\README.md</readme>
    <description>An NServiceBus-compatible endpoint for .NET nanoFramework devices, over MQTT 5. It speaks the wire contract of NServiceBus.Community.Mqtt, so a device can send, receive, reply, publish and subscribe next to .NET endpoints.</description>
    <tags>nanoFramework C# csharp netmf netnf NServiceBus MQTT IoT ESP32</tags>
    <dependencies>
      <dependency id="nanoFramework.CoreLibrary" version="[1.17.11]" />
      <dependency id="nanoFramework.Logging" version="[1.1.161]" />
      <dependency id="nanoFramework.M2Mqtt" version="[5.1.226]" />
      <dependency id="nanoFramework.Runtime.Events" version="[1.11.39]" />
      <dependency id="nanoFramework.Runtime.Native" version="[1.7.11]" />
      <dependency id="nanoFramework.System.Collections" version="[1.5.75]" />
      <dependency id="nanoFramework.System.Net" version="[1.11.64]" />
      <dependency id="nanoFramework.System.Text" version="[1.3.42]" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\NServiceBus.Community.NanoframeworkMQTT.dll" target="lib\NServiceBus.Community.NanoframeworkMQTT.dll" />
    <file src="bin\Release\NServiceBus.Community.NanoframeworkMQTT.pdb" target="lib\NServiceBus.Community.NanoframeworkMQTT.pdb" />
    <file src="bin\Release\NServiceBus.Community.NanoframeworkMQTT.pdbx" target="lib\NServiceBus.Community.NanoframeworkMQTT.pdbx" />
    <file src="bin\Release\NServiceBus.Community.NanoframeworkMQTT.pe" target="lib\NServiceBus.Community.NanoframeworkMQTT.pe" />
    <file src="bin\Release\NServiceBus.Community.NanoframeworkMQTT.xml" target="lib\NServiceBus.Community.NanoframeworkMQTT.xml" />
    <file src="..\..\README.md" target="docs\" />
  </files>
</package>
