<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NServiceBus.Community.Mqtt</AssemblyName>
    <PackageId>NServiceBus.Community.Mqtt</PackageId>
    <Version>2.0.0</Version>
    <Authors>WilliamBZA</Authors>
    <PackageTags>NServiceBus; Mqtt; IoT; Microservice;</PackageTags>
    <Description>
      This client library enables NServiceBus endpoints to communicate with MQTT brokers. Library does not support delayed delivery.
    </Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.3.952" />
    <PackageReference Include="NServiceBus" Version="[10.2.9, 11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NServiceBus.Community.Mqtt.Tests" />
    <InternalsVisibleTo Include="NServiceBus.Community.Mqtt.TransportTests" />
    <InternalsVisibleTo Include="NServiceBus.Community.Mqtt.AcceptanceTests" />
  </ItemGroup>

</Project>
